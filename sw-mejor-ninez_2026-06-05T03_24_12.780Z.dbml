Table NNA [headercolor: #175e7a] {
	id_nna uuid [ pk, unique, default: `gen_random_uuid()` ]
	id_sis text [ note: 'ID asignado por la plataforma externa SIS' ]
	run text
	nombre text [ note: 'nombre del niño' ]
	fecha_nacimiento date
	sexo text
	etnia_declarada text
	nacionalidad text
	domicilio text
	comuna text
	region text
}

Table Familiar [headercolor: #175e7a] {
	id_familiar uuid [ pk, unique, default: `gen_random_uuid()` ]
	nombre text
	fecha_nacimiento date
	run text
	direccion text
	numero_telefono text
	tiene_antecedentes_penales boolean [ not null, default: false ]
}

Table HistorialConsumoNNA [headercolor: #175e7a] {
	id_historial_consumo uuid [ pk, unique, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	nombre_sustancia text
	consumo_indirecto_gestacional boolean [ not null, default: false ]
	estado_consumo text
	fecha_inicio date
	fecha_termino date
	en_tratamiento boolean [ not null, default: false ]
}

Table DiscapacidadNNA [headercolor: #175e7a] {
	id_discapacidad uuid [ pk, unique, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	tipo text
	porcentaje_grado integer
	observacion text
}

Table AntecedenteIngreso [headercolor: #175e7a] {
	id_antecedente_ingreso uuid [ pk, unique, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	id_solicitante_ingreso uuid [ not null ]
	fecha_ingreso_residencia date
	orden_tribunal boolean [ not null, default: false ]
	fecha_causa date
	tribunal text
	materia text
	codigo_rit text
	codigo_ruc text
}

Table DocumentacionIngreso [headercolor: #175e7a] {
	id_documentacion uuid [ pk, unique, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	tipo_documento text
	estado_recepcion boolean [ not null, default: false ]
	fecha_recepcion date
	observacion text
}

Table HistorialRedProteccional [headercolor: #175e7a] {
	id_historial_red uuid [ pk, unique, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	nombre_programa text
	fecha_ingreso date
	fecha_egreso date
	motivo_egreso text
}

Table GestionBusquedaFamiliar [headercolor: #175e7a] {
	id_gestion_busqueda uuid [ pk, unique, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	tipo_gestion text
	fecha_solicitud_envio date
	fecha_respuesta_recepcion date
	resultado text
	comprobante_adjunto boolean [ not null, default: false ]
}

Table InformeTribunal [headercolor: #175e7a] {
	id_informe uuid [ pk, unique, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	tipo_informe text
	fecha_vencimiento date
	fecha_envio_real date
	estado text
}

Table AntecedenteSalud [headercolor: #175e7a] {
	id_antecedente_salud uuid [ pk, unique, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	id_centro_salud uuid
	fecha_antecedente_salud date
	prevision text [ note: 'Debe ser lista: FONASA, ISAPRE, Particular, Ninguna' ]
	"inscrito_en_centro salud" boolean [ not null, default: false ]
}

Table AntecedenteEscolar [headercolor: #175e7a] {
	id_antecedente_escolar uuid [ pk, unique, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	id_establecimiento_educacional uuid
	fecha_antecedente_escolar date
	ultimo_ano_cursado integer
	escolarizado boolean [ not null, default: false ]
}

Table AntecedenteFamiliar [headercolor: #175e7a] {
	id_antecedente_familiar uuid [ pk, unique, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	id_adulto_responsable uuid
	fecha_antecedente_familiar date
	con_quien_vive text [ note: 'Ej: Ambos padres, madre con pareja nueva, no parientes con vinculo afectivo, ... ,  otro.' ]
	con_quien_vive_detalle text [ note: 'si con_quien_vive == ''''Otro'''', guardar detalle aca.' ]
}

Table RegistroCausalIngreso [headercolor: #175e7a] {
	id_registro_causales uuid [ pk, unique, default: `gen_random_uuid()` ]
	id_antecedente_ingreso uuid [ not null ]
	nombre_causal text
	descripcion_detallada text
	estado text
}

Table RegistroDerechoVulnerado [headercolor: #175e7a] {
	id_registro_derecho_vulnerado uuid [ pk, unique, default: `gen_random_uuid()` ]
	id_antecedente_ingreso uuid [ not null ]
	nombre_derecho text
	estado text
}

Table VinculoFamiliar [headercolor: #175e7a] {
	id_vinculo_familiar uuid [ pk, unique, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	id_familiar uuid [ not null ]
	parentesco text
}

Table AntecedentesPenales [headercolor: #175e7a] {
	id_antecedentes_penales uuid [ pk, unique, default: `gen_random_uuid()` ]
	id_familiar uuid [ not null ]
	descripcion text
	url_documento_adjunto text [ note: 'Ruta al PDF del extracto de filiación del tribunal' ]
}

Table HistorialConsumoAdulto [headercolor: #175e7a] {
	id_historial_consumo uuid [ pk, unique, default: `gen_random_uuid()` ]
	id_familiar uuid [ not null ]
	nombre_sustancia text
	estado_consumo text
	fecha_inicio date
	fecha_termino date
	en_tratamiento boolean [ not null, default: false ]
}

Table DiscapacidadAdulto [headercolor: #175e7a] {
	id_discapacidad uuid [ pk, unique, default: `gen_random_uuid()` ]
	id_familiar uuid [ not null ]
	tipo text
	porcentaje_grado integer
	observacion text
}

Table PMF [headercolor: #175e7a] {
	id_instrumento uuid [ pk, unique, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	id_familiar uuid [ not null ]
	fecha_evaluacion date
	fecha_proxima_evaluacion date
	resultado text
	observacion text
}

Table NCFAS [headercolor: #175e7a] {
	id_instrumento uuid [ pk, unique, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	id_familiar uuid [ not null ]
	fecha_evaluacion date
	fecha_proxima_evaluacion date
	resultado text
	observacion text
}

Table E2P [headercolor: #175e7a] {
	id_instrumento uuid [ pk, unique, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	id_familiar uuid [ not null ]
	fecha_evaluacion date
	fecha_proxima_evaluacion date
	version integer [ not null ]
	resultado text
	observacion text
}

Table PreguntaE2P [headercolor: #175e7a] {
	id_pregunta_e2p uuid [ pk, unique, default: `gen_random_uuid()` ]
	version integer [ not null ]
	numero integer [ not null ]
	texto text [ not null ]
	categoria text [ not null ]
}

Table RespuestaE2P [headercolor: #175e7a] {
	id_respuesta_e2p uuid [ pk, unique, default: `gen_random_uuid()` ]
	id_instrumento uuid [ not null ]
	id_pregunta_e2p uuid [ not null ]
	valor integer [ not null ]
}

Table BaremoE2P [headercolor: #175e7a] {
	id_baremo_e2p uuid [ pk, unique, default: `gen_random_uuid()` ]
	version integer [ not null ]
	categoria text [ not null ]
	zona text [ not null ]
	puntaje_min integer [ not null ]
	puntaje_max integer [ not null ]
}

Table PuntajeE2P [headercolor: #175e7a] {
	id_puntaje_e2p uuid [ pk, unique, default: `gen_random_uuid()` ]
	id_instrumento uuid [ not null ]
	categoria text [ not null ]
	puntaje_bruto integer [ not null ]
	puntaje_max integer [ not null ]
	zona text [ not null ]
	rango_zona text [ not null ]
}

Table SolicitanteIngreso [headercolor: #175e7a] {
	id_solicitante_ingreso uuid [ pk, unique, default: `gen_random_uuid()` ]
	nombre text
	categoria text [ note: 'Ej: PRM, PRK, PRF, Hospital, etc.' ]
	ano_proyecto integer [ note: 'Año de adjudicación o vigencia del proyecto' ]
}

Table EstablecimientoEducacional [headercolor: #175e7a] {
	id_establecimiento_educacional uuid [ pk, unique, default: `gen_random_uuid()` ]
	nombre text
	rbd integer [ note: 'Rol Base de Datos del establecimiento' ]
}

Table CentroSalud [headercolor: #175e7a] {
	id_centro_salud uuid [ pk, unique, default: `gen_random_uuid()` ]
	nombre text
	tipo_recinto text [ note: 'Ej: CESFAM, Hospital, Clínica Privada, CECOSF' ]
}

Table RegistroGrupoFamiliar [headercolor: #175e7a] {
	id_familiar uuid [ pk, unique, default: `gen_random_uuid()` ]
	id_antecedente_familiar uuid [ pk ]
}

Ref fk_HistorialConsumoNNA_id_nna_NNA {
	HistorialConsumoNNA.id_nna > NNA.id_nna [ delete: no action, update: no action ]
}

