Table Caso {
	id_caso uuid [ pk, default: `gen_random_uuid()` ]
	id_nna uuid [ not null, ref: > NNA.id_nna ]
  fecha_inicio date
  fecha_termino date
  estado text

  Checks {
    `"estado" IN ('En Progreso', 'Cerrado')` [name: 'chk_estado_caso']
  }
}

Table NNA  {
	id_nna uuid [ pk, default: `gen_random_uuid()` ]
	id_sis text [ unique, note: 'ID asignado por la plataforma externa SIS' ]
	run text [ unique ]
	nombre text [ note: 'nombre del niño' ]
	fecha_nacimiento date
	sexo text
	etnia_declarada text
	nacionalidad text
	domicilio text
	comuna text
	region text
  // poblacion_o_villa text
}

Table Familiar  {
	id_familiar uuid [ pk, default: `gen_random_uuid()` ]
	nombre text
	fecha_nacimiento date
	run text
	direccion text
	numero_telefono text
  // tiene_antecedentes_penales boolean NOT NULL
}

Table HistorialConsumoNNA  {
	id_historial_consumo_nna uuid [ pk, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	nombre_sustancia text
	consumo_indirecto_gestacional boolean [ not null, default: false ]
	estado_consumo text
	fecha_inicio date
	fecha_termino date
	en_tratamiento boolean [ not null, default: false ]
}

Table DiscapacidadNNA  {
	id_discapacidad_nna uuid [ pk, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	tipo text
	porcentaje_grado integer
	observacion text
}

Table AntecedenteIngreso  {
	id_antecedente_ingreso uuid [ pk, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	id_solicitante_ingreso uuid [ not null ]
	id_caso uuid [ ref: > Caso.id_caso ]
	fecha_ingreso_residencia date
	orden_tribunal boolean [ not null, default: false ]
	fecha_causa date
	tribunal text
	materia text
	codigo_rit text
	codigo_ruc text
}

Table DocumentacionIngreso  {
	id_documentacion uuid [ pk, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	id_caso uuid [ ref: > Caso.id_caso ]
	tipo_documento text
	estado_recepcion boolean [ not null, default: false ]
	fecha_recepcion date
  url_documentacion_ingreso text
	observacion text
}

Table HistorialRedProteccional  {
	id_historial_red uuid [ pk, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	nombre_programa text
	fecha_ingreso date
	fecha_egreso date
	motivo_egreso text
}

// 1. CABECERA DEL PROCESO DE DESPEJE POR NNA
// Registra el estado macro de la búsqueda del informe de hijo y el resultado general
Table ProcesoDespejeFamiliar {
  id_despeje uuid [ pk, default: `gen_random_uuid()` ]
  id_nna uuid [ not null, unique, note: 'Un proceso de despeje único por NNA' ]
  id_caso uuid [ ref: > Caso.id_caso ]
  fecha_solicitud_informe date [ note: 'Fecha en que el tribunal ordena el informe de hijo al Registro Civil' ]
  fecha_recepcion_informe date [ note: 'Fecha en que llega el árbol genealógico de 3 generaciones' ]
  estado text [ note: 'Ej: Pendiente Informe, En Notificación, Evaluando, Cerrado Sin Red, Cerrado Con Red' ]
  url_informe_hijo text [ note: 'Ruta al documento PDF del árbol genealógico' ]
}

// 2. DETALLE DE NOTIFICACIONES POR FAMILIAR
// Registra el envío individual de cartas certificadas a cada familiar identificado
Table NotificacionFamiliar {
  id_notificacion uuid [ pk, default: `gen_random_uuid()` ]
  id_despeje uuid [ not null ]
  id_familiar uuid [ not null, note: 'Familiar del árbol genealógico al que se le envía la carta' ]
  
  // Ronda 1
  fecha_envio_carta_1 date [ note: 'Fecha de envío de la primera carta certificada' ]
  codigo_seguimiento_1 text [ note: 'Código de Correos de Chile para el tracking' ]
  estado_entrega_1 text [ note: 'Ej: Entregada, Devuelta por dirección incorrecta, En tránsito' ]
  fecha_recepcion_carta_1 date
  
  // Ronda 2 (Se gatilla si pasan 30 días de la Ronda 1 sin respuesta)
  fecha_envio_carta_2 date [ note: 'Fecha de envío de la segunda carta certificada' ]
  codigo_seguimiento_2 text
  estado_entrega_2 text
  fecha_recepcion_carta_2 date

  // Resultado final del contacto con este familiar específico
  resultado_contacto text [ note: 'Ej: No responde, Rechaza participación, Acepta evaluación, Fallecido' ]
  fecha_respuesta date [ note: 'Fecha en que el familiar responde o asiste' ]
  observacion text
}

Table InformeTribunal  {
	id_informe uuid [ pk, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	id_caso uuid [ ref: > Caso.id_caso ]
	tipo_informe text
	fecha_vencimiento date
	fecha_envio_real date
	estado text
  url_documento text
}

Table AntecedenteSalud  {
	id_antecedente_salud uuid [ pk, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	id_caso uuid [ ref: > Caso.id_caso ]
	id_centro_salud uuid
	fecha_antecedente_salud date
	prevision text [ note: 'Debe ser lista: FONASA, ISAPRE, Particular, Ninguna' ]
	inscrito_en_centro_salud boolean [ not null, default: false ]
}

Table AntecedenteEscolar  {
	id_antecedente_escolar uuid [ pk, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	id_caso uuid [ ref: > Caso.id_caso ]
	id_establecimiento_educacional uuid
	fecha_antecedente_escolar date
	ultimo_ano_cursado integer
	escolarizado boolean [ not null, default: false ]
}

Table AntecedenteFamiliar  {
	id_antecedente_familiar uuid [ pk, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	id_caso uuid [ ref: > Caso.id_caso ]
	id_adulto_responsable uuid
	fecha_antecedente_familiar date
	con_quien_vive text [ note: 'Ej: Ambos padres, madre con pareja nueva, no parientes con vinculo afectivo, ... ,  otro.' ]
	con_quien_vive_detalle text [ note: 'si con_quien_vive == "Otro", guardar detalle aca.' ]
}

Table RegistroCausalIngreso  {
	id_registro_causales uuid [ pk, default: `gen_random_uuid()` ]
	id_antecedente_ingreso uuid [ not null ]
	nombre_causal text
	descripcion_detallada text
	estado text
}

Table RegistroDerechoVulnerado  {
	id_registro_derecho_vulnerado uuid [ pk, default: `gen_random_uuid()` ]
	id_antecedente_ingreso uuid [ not null ]
	nombre_derecho text
	estado text
}

Table VinculoFamiliar  {
	id_vinculo_familiar uuid [ pk, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	id_familiar uuid [ not null ]
	parentesco text
}

Table AntecedentePenal  {
	id_antecedente_penal uuid [ pk, default: `gen_random_uuid()` ]
	id_familiar uuid [ not null ]
	descripcion text
	url_documento_adjunto text [ note: 'Ruta al PDF del extracto de filiación del tribunal' ]
}

Table HistorialConsumoAdulto  {
	id_historial_consumo_adulto uuid [ pk, default: `gen_random_uuid()` ]
	id_familiar uuid [ not null ]
	nombre_sustancia text
	estado_consumo text
	fecha_inicio date
	fecha_termino date
	en_tratamiento boolean [ not null, default: false ]
}

Table DiscapacidadAdulto  {
	id_discapacidad_adulto uuid [ pk, default: `gen_random_uuid()` ]
	id_familiar uuid [ not null ]
	tipo text
	porcentaje_grado integer
	observacion text
}

Table PMF  {
	id_pmf uuid [ pk, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	id_familiar uuid [ not null ]
	id_caso uuid [ ref: > Caso.id_caso ]
	fecha_evaluacion date
	fecha_proxima_evaluacion date
	resultado text
	observacion text
}

Table PreguntaPMF  {
	id_pregunta_pmf uuid [ pk, default: `gen_random_uuid()` ]
	numero integer [ not null ]
	afirmacion text [ not null ]
	escala text 
}

Table RespuestaPMF  {
	id_respuesta_pmf uuid [ pk, default: `gen_random_uuid()` ]
	id_pmf uuid [ not null ]
	id_pregunta_pmf uuid [ not null ]
	respuesta bool [ not null ]
}

// 1. Cabecera de la Evaluación NCFAS
// Representa el "ciclo" completo de evaluación de una familia durante la intervención
Table NCFAS  {
	id_ncfas uuid [ pk, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	id_familiar uuid [ not null, note: 'Cuidador principal evaluado junto al NNA' ]
  id_caso uuid [ ref: > Caso.id_caso ]
  "es_reunificacion" boolean [not null, default: false]

	fecha_apertura date [ note: 'Fecha en que se realiza la evaluación de Ingreso' ]
	fecha_cierre date [ note: 'Fecha en que se realiza la evaluación de Cierre' ]
	estado text [ note: 'Ej: Ingreso completado, Intermedio completado, Finalizado' ]
	observacion_general text
}

// 2. Catálogo de Ítems (Las preguntas del instrumento)
// Ej: Dimensión "A. Entorno", Ítem "1. Estabilidad de la vivienda"
Table ItemNCFAS  {
	id_item_ncfas uuid [ pk, default: `gen_random_uuid()` ]
	letra_dimension text [ not null, note: 'Ej: A, B, C, D...' ]
	nombre_dimension text [ not null, note: 'Ej: Entorno, Competencias Parentales...' ]
	numero_item integer [ not null, note: 'Ej: 1, 2, 3...' ]
	nombre_item text [ not null, note: 'Ej: Estabilidad de la Vivienda' ]
  definiciones json
  es_item_general boolean [not null, default: false]

}

// 3. Respuestas/Puntuaciones
// Almacena el puntaje específico para un ítem, en un momento específico
Table RespuestaNCFAS  {
	id_respuesta_ncfas uuid [ pk, default: `gen_random_uuid()` ]
	id_ncfas uuid [ not null ]
	id_item_ncfas uuid [ not null ]
	momento_evaluacion text [ not null, note: 'Valores permitidos: Ingreso, Intermedio, Cierre' ]
	puntaje text [ not null, note: 'Valores: +2, +1, 0, -1, -2, -3, DN, N/A' ]

  // Garantiza que no se evalúe el mismo ítem dos veces en el mismo momento
  indexes {
    (id_ncfas, id_item_ncfas, momento_evaluacion) [unique]
  }


  Checks {
    `"momento_evaluacion" IN ('Ingreso', 'Intermedio', 'Cierre')` [name: 'chk_momento_evaluacion']
    `"puntaje" IN ('+2', '+1', '0', '-1', '-2', '-3', 'DN', 'N/A')` [name: 'chk_puntaje']
  }
}

// 4. Comentarios por Dimensión
// Almacena la caja de "Comentarios" que aparece al final de cada sección en el PDF
Table ComentarioDimensionNCFAS {
	id_comentario_ncfas uuid [ pk, default: `gen_random_uuid()` ]
	id_ncfas uuid [ not null ]
	letra_dimension text [ not null, note: 'Ej: A, B, C...' ]
	comentario text [ not null ]
  
  // Solo un bloque de comentarios por dimensión por caso
  indexes {
    (id_ncfas, letra_dimension) [unique]
  }
}

// 1. CABECERA DE LA EVALUACIÓN
// Representa la aplicación de una encuesta a una díada (NNA + Cuidador) en una fecha específica.
Table E2P {
  id_e2p uuid [ pk, default: `gen_random_uuid()` ]
  id_nna uuid [ not null ]
  id_familiar uuid [ not null ]
  id_caso uuid [ ref: > Caso.id_caso ]
  fecha_evaluacion date [ not null ]
  edad_meses_evaluacion integer [ not null, note: 'Edad del NNA en meses al momento de ser evaluado' ]
  rango_etario text [ not null, note: 'Rango etario de la versión aplicada: 0-3_meses, 4-10_meses, etc.' ]
  perfil_resultado_global text [ note: 'Resultado sintético del perfil: Riesgo, Monitoreo, Optimo' ]
  observacion text

  Checks {
    `rango_etario IN ('0-3_meses', '4-10_meses', '11-18_meses', '19-36_meses', '3-5_anos', '6-7_anos', '8-12_anos', '13-17_anos')` [name: "chk_edad_dentro_de_rango"]
    `perfil_resultado_global IN ('Riesgo', 'Monitoreo', 'Optimo')` [name: "chk_perfil_resultado"]
  }
}

// 2. BANCO DE PREGUNTAS (Reactivos por rango etario)
// Cada rango etario tiene sus propias preguntas con textos y ejemplos específicos.
Table PreguntaE2P {
  id_pregunta_e2p uuid [ pk, default: `gen_random_uuid()` ]
  rango_etario text [ not null ]
  numero_item integer [ not null, note: 'Número correlativo (1 al 60 o 1 al 56)' ]
  texto_afirmacion text [ not null, note: 'Ej: Percibo las nuevas señales que empieza a generar mi hijo/a...' ]
  dimension text [ not null, note: 'Vinculares, Formativas, Protectoras, Reflexivas' ]
  subdimension text [ note: 'Subdimensión específica (ej: Regulación del estrés, Calidez emocional...)' ]

  indexes {
    (rango_etario, numero_item) [unique]
  }

  Checks {
    `rango_etario IN ('0-3_meses', '4-10_meses', '11-18_meses', '19-36_meses', '3-5_anos', '6-7_anos', '8-12_anos', '13-17_anos')` [name: "chk_edad_dentro_de_rango"]
    `dimension IN ('Vinculares', 'Formativas', 'Protectoras', 'Reflexivas')` [name: "chk_dimension"]
  }
}

// 3. RESPUESTAS DETALLADAS
// Registra la respuesta del evaluado para cada ítem.
Table RespuestaE2P {
  id_respuesta_e2p uuid [ pk, default: `gen_random_uuid()` ]
  id_e2p uuid [ not null ]
  id_pregunta_e2p uuid [ not null ]
  valor_seleccionado integer [ not null, note: '0: Nunca, 1: Casi Nunca, 2: A veces, 3: Casi Siempre, 4: Siempre' ]
  puntaje_calculado integer [ not null, note: 'Puntaje clínico real asignado tras aplicar reglas o excepciones' ]

  indexes {
    (id_e2p, id_pregunta_e2p) [unique]
  }

  Checks {
    `valor_seleccionado BETWEEN 0 AND 4`
    `puntaje_calculado BETWEEN 0 AND 4`
  }
}

// 4. TABLA DE BAREMOS (Normalización por rango etario)
// Permite traducir puntajes brutos a deciles y zonas de frecuencia para cada dimensión.
Table BaremoE2P {
  id_baremo_e2p uuid [ pk, default: `gen_random_uuid()` ]
  rango_etario text [ not null ]
  dimension text [ not null, note: 'Vinculares, Formativas, Protectoras, Reflexivas, Total' ]
  decil integer [ not null, note: 'Decil obtenido (1 al 10)' ]
  zona text [ not null, note: 'Baja frecuencia, Frecuencia intermedia, Alta frecuencia' ]
  puntaje_min integer [ not null ]
  puntaje_max integer [ not null ]

  Checks {
    `rango_etario IN ('0-3_meses', '4-10_meses', '11-18_meses', '19-36_meses', '3-5_anos', '6-7_anos', '8-12_anos', '13-17_anos')`
    `dimension IN ('Vinculares', 'Formativas', 'Protectoras', 'Reflexivas', 'Total')`
    `decil BETWEEN 1 AND 10`
    `zona IN ('Baja frecuencia', 'Frecuencia intermedia', 'Alta frecuencia')`
  }
}

// 5. RESUMEN DE PUNTAJES POR DIMENSIÓN
// Almacena los resultados calculados por dimensión para agilizar reportería y generación de gráficos de perfil.
Table PuntajeE2P {
  id_puntaje_e2p uuid [ pk, default: `gen_random_uuid()` ]
  id_e2p uuid [ not null ]
  dimension text [ not null, note: 'Vinculares, Formativas, Protectoras, Reflexivas, Total' ]
  puntaje_bruto integer [ not null, note: 'Suma de los puntos de los reactivos correspondientes' ]
  decil integer [ note: 'Decil obtenido según Baremo' ]
  zona text [ note: 'Baja frecuencia, Frecuencia intermedia o Alta frecuencia' ]

  indexes {
    (id_e2p, dimension) [unique]
  }

  Checks {
    `dimension IN ('Vinculares', 'Formativas', 'Protectoras', 'Reflexivas', 'Total')`
    `zona IN ('Baja frecuencia', 'Frecuencia intermedia', 'Alta frecuencia')`
  }
}

Table SolicitanteIngreso  {
	id_solicitante_ingreso uuid [ pk, default: `gen_random_uuid()` ]
	nombre text
	categoria text [ note: 'Ej: PRM, PRK, PRF, Hospital, etc.' ]
	ano_proyecto integer [ note: 'Año de adjudicación o vigencia del proyecto' ]
}

Table EstablecimientoEducacional  {
	id_establecimiento_educacional uuid [ pk, default: `gen_random_uuid()` ]
	nombre text
	rbd integer [ note: 'Rol Base de Datos del establecimiento' ]
}

Table CentroSalud  {
	id_centro_salud uuid [ pk, default: `gen_random_uuid()` ]
	nombre text
	tipo_recinto text [ note: 'Ej: CESFAM, Hospital, Clínica Privada, CECOSF' ]
}

Table RegistroGrupoFamiliar  {
	id_registro_grupo_familiar uuid [ pk, default: `gen_random_uuid()` ]
	id_familiar uuid [ not null ]
	id_antecedente_familiar uuid [ not null ]

  // Un familiar no puede estar duplicado en el mismo antecedente
  indexes {
    (id_familiar, id_antecedente_familiar) [unique]
  }
}

Table VinculoNNA  {
	id_vinculo_nna uuid [ pk, default: `gen_random_uuid()` ]
	id_nna_1 uuid [ not null ]
	id_nna_2 uuid [ not null ]
	parentesco text

  // Evitamos que se registre dos veces exactamente el mismo vínculo
  indexes {
    (id_nna_1, id_nna_2) [unique]
  }

  checks {
    `id_nna_1 < id_nna_2` [name: 'chk_vinculo_nna_orden']
  }
}

Table Usuario {
  id_usuario uuid [pk, not null]
  email text [not null, unique]
  hashed_password text [not null]
  nombre text 
  is_active bool [not null]
  created_at timestampz [not null, default: 'now()']
  updated_at timestampz
}

/*
Table CatalogoCausal {
	id_catalogo_causal uuid [ pk, default: `gen_random_uuid()` ]
	nombre text [ note: 'Ej: Negligencia, Consumo problemático, Abuso...' ]
	clasificacion text [ note: 'Opcional: Leve, Moderado, Grave' ]
}

Table CatalogoDerecho {
	id_catalogo_derecho uuid [ pk, default: `gen_random_uuid()` ]
	nombre text [ note: 'Ej: Derecho a la educación, Derecho a la integridad...' ]
}

Table CatalogoDocumento {
	id_catalogo_documento uuid [ pk, default: `gen_random_uuid()` ]
	nombre text [ note: 'Ej: Constatación de lesiones, Orden judicial, Certificado nacimiento...' ]
}
*/

// --- RELACIONES (Foreign Keys) ---


Ref fk_HistorialConsumoNNA_id_nna_NNA {
	HistorialConsumoNNA.id_nna > NNA.id_nna [ delete: no action, update: no action ]
}

Ref fk_DiscapacidadNNA_id_nna_NNA {
	DiscapacidadNNA.id_nna > NNA.id_nna [ delete: no action, update: no action ]
}

Ref fk_AntecedenteIngreso_id_nna_NNA {
	AntecedenteIngreso.id_nna > NNA.id_nna [ delete: no action, update: no action ]
}

Ref fk_DocumentacionIngreso_id_nna_NNA {
	DocumentacionIngreso.id_nna > NNA.id_nna [ delete: no action, update: no action ]
}

Ref fk_HistorialRedProteccional_id_nna_NNA {
	HistorialRedProteccional.id_nna > NNA.id_nna [ delete: no action, update: no action ]
}

Ref fk_ProcesoDespeje_id_nna_NNA {
  ProcesoDespejeFamiliar.id_nna > NNA.id_nna [ delete: no action, update: no action ]
}

Ref fk_NotificacionFamiliar_id_despeje {
  NotificacionFamiliar.id_despeje > ProcesoDespejeFamiliar.id_despeje [ delete: cascade, update: no action ]
}

Ref fk_NotificacionFamiliar_id_familiar {
  NotificacionFamiliar.id_familiar > Familiar.id_familiar [ delete: no action, update: no action ]
}

Ref fk_InformeTribunal_id_nna_NNA {
	InformeTribunal.id_nna > NNA.id_nna [ delete: no action, update: no action ]
}

Ref fk_AntecedenteSalud_id_nna_NNA {
	AntecedenteSalud.id_nna > NNA.id_nna [ delete: no action, update: no action ]
}

Ref fk_AntecedenteEscolar_id_nna_NNA {
	AntecedenteEscolar.id_nna > NNA.id_nna [ delete: no action, update: no action ]
}

Ref fk_AntecedenteFamiliar_id_nna_NNA {
	AntecedenteFamiliar.id_nna > NNA.id_nna [ delete: no action, update: no action ]
}

Ref fk_RegistroCausalIngreso_id_antecedente_ingreso_AntecedenteIngreso {
	RegistroCausalIngreso.id_antecedente_ingreso > AntecedenteIngreso.id_antecedente_ingreso [ delete: no action, update: no action ]
}

Ref fk_RegistroDerechoVulnerado_id_antecedente_ingreso_AntecedenteIngreso {
	RegistroDerechoVulnerado.id_antecedente_ingreso > AntecedenteIngreso.id_antecedente_ingreso [ delete: no action, update: no action ]
}

Ref fk_VinculoFamiliar_id_nna_NNA {
	VinculoFamiliar.id_nna > NNA.id_nna [ delete: no action, update: no action ]
}

Ref fk_VinculoFamiliar_id_familiar_Familiar {
	VinculoFamiliar.id_familiar > Familiar.id_familiar [ delete: no action, update: no action ]
}

Ref fk_AntecedentesPenales_id_familiar_Familiar {
	AntecedentePenal.id_familiar > Familiar.id_familiar [ delete: no action, update: no action ]
}

Ref fk_HistorialConsumoAdulto_id_familiar_Familiar {
	HistorialConsumoAdulto.id_familiar > Familiar.id_familiar [ delete: no action, update: no action ]
}

Ref fk_DiscapacidadAdulto_id_familiar_Familiar {
	DiscapacidadAdulto.id_familiar > Familiar.id_familiar [ delete: no action, update: no action ]
}


Ref fk_PMF_id_nna_NNA {
	PMF.id_nna > NNA.id_nna [ delete: no action, update: no action ]
}

Ref fk_PMF_id_familiar_Familiar {
	PMF.id_familiar > Familiar.id_familiar [ delete: no action, update: no action ]
}

Ref fk_NCFAS_id_nna_NNA {
	NCFAS.id_nna > NNA.id_nna [ delete: no action, update: no action ]
}

Ref fk_NCFAS_id_familiar_Familiar {
	NCFAS.id_familiar > Familiar.id_familiar [ delete: no action, update: no action ]
}

Ref fk_E2P_id_nna_NNA {
  E2P.id_nna > NNA.id_nna [ delete: no action, update: no action ]
