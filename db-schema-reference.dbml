Table NNA  {
	id_nna uuid [ pk, default: `gen_random_uuid()` ]
	id_sis text [ unique, note: 'ID asignado por la plataforma externa SIS' ]
	run text [ unique ]
	nombre text [ note: 'nombre del niño' ]
	fecha_nacimiento date
	sexo text
	etnia_declarada text
	nacionalidad text
	domicilio text
	comuna text
	region text
}

Table Familiar  {
	id_familiar uuid [ pk, default: `gen_random_uuid()` ]
	nombre text
	fecha_nacimiento date
	run text
	direccion text
	numero_telefono text
}

Table HistorialConsumoNNA  {
	id_historial_consumo_nna uuid [ pk, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	nombre_sustancia text
	consumo_indirecto_gestacional boolean [ not null, default: false ]
	estado_consumo text
	fecha_inicio date
	fecha_termino date
	en_tratamiento boolean [ not null, default: false ]
}

Table DiscapacidadNNA  {
	id_discapacidad_nna uuid [ pk, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	tipo text
	porcentaje_grado integer
	observacion text
}

Table AntecedenteIngreso  {
	id_antecedente_ingreso uuid [ pk, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	id_solicitante_ingreso uuid [ not null ]
	fecha_ingreso_residencia date
	orden_tribunal boolean [ not null, default: false ]
	fecha_causa date
	tribunal text
	materia text
	codigo_rit text
	codigo_ruc text
}

Table DocumentacionIngreso  {
	id_documentacion uuid [ pk, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	tipo_documento text
	estado_recepcion boolean [ not null, default: false ]
	fecha_recepcion date
  url_documentacion_ingreso text
	observacion text
}

Table HistorialRedProteccional  {
	id_historial_red uuid [ pk, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	nombre_programa text
	fecha_ingreso date
	fecha_egreso date
	motivo_egreso text
}

Table GestionBusquedaFamiliar  {
	id_gestion_busqueda uuid [ pk, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	tipo_gestion text
	fecha_solicitud_envio date
	fecha_respuesta_recepcion date
	resultado text
	comprobante_adjunto boolean [ not null, default: false ]
}

Table InformeTribunal  {
	id_informe uuid [ pk, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	tipo_informe text
	fecha_vencimiento date
	fecha_envio_real date
	estado text
}

Table AntecedenteSalud  {
	id_antecedente_salud uuid [ pk, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	id_centro_salud uuid
	fecha_antecedente_salud date
	prevision text [ note: 'Debe ser lista: FONASA, ISAPRE, Particular, Ninguna' ]
	inscrito_en_centro_salud boolean [ not null, default: false ]
}

Table AntecedenteEscolar  {
	id_antecedente_escolar uuid [ pk, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	id_establecimiento_educacional uuid
	fecha_antecedente_escolar date
	ultimo_ano_cursado integer
	escolarizado boolean [ not null, default: false ]
}

Table AntecedenteFamiliar  {
	id_antecedente_familiar uuid [ pk, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	id_adulto_responsable uuid
	fecha_antecedente_familiar date
	con_quien_vive text [ note: 'Ej: Ambos padres, madre con pareja nueva, no parientes con vinculo afectivo, ... ,  otro.' ]
	con_quien_vive_detalle text [ note: 'si con_quien_vive == "Otro", guardar detalle aca.' ]
}

Table RegistroCausalIngreso  {
	id_registro_causales uuid [ pk, default: `gen_random_uuid()` ]
	id_antecedente_ingreso uuid [ not null ]
	nombre_causal text
	descripcion_detallada text
	estado text
}

Table RegistroDerechoVulnerado  {
	id_registro_derecho_vulnerado uuid [ pk, default: `gen_random_uuid()` ]
	id_antecedente_ingreso uuid [ not null ]
	nombre_derecho text
	estado text
}

Table VinculoFamiliar  {
	id_vinculo_familiar uuid [ pk, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	id_familiar uuid [ not null ]
	parentesco text
}

Table AntecedentePenal  {
	id_antecedente_penal uuid [ pk, default: `gen_random_uuid()` ]
	id_familiar uuid [ not null ]
	descripcion text
	url_documento_adjunto text [ note: 'Ruta al PDF del extracto de filiación del tribunal' ]
}

Table HistorialConsumoAdulto  {
	id_historial_consumo_adulto uuid [ pk, default: `gen_random_uuid()` ]
	id_familiar uuid [ not null ]
	nombre_sustancia text
	estado_consumo text
	fecha_inicio date
	fecha_termino date
	en_tratamiento boolean [ not null, default: false ]
}

Table DiscapacidadAdulto  {
	id_discapacidad_adulto uuid [ pk, default: `gen_random_uuid()` ]
	id_familiar uuid [ not null ]
	tipo text
	porcentaje_grado integer
	observacion text
}

Table PMF  {
	id_pmf uuid [ pk, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	id_familiar uuid [ not null ]
	fecha_evaluacion date
	fecha_proxima_evaluacion date
	resultado text
	observacion text
}

Table PreguntaPMF  {
	id_pregunta_pmf uuid [ pk, default: `gen_random_uuid()` ]
	numero integer [ not null ]
	afirmacion text [ not null ]
	escala text 
}

Table RespuestaPMF  {
	id_respuesta_pmf uuid [ pk, default: `gen_random_uuid()` ]
	id_pmf uuid [ not null ]
	id_pregunta_pmf uuid [ not null ]
	respuesta bool [ not null ]
}

// 1. Cabecera de la Evaluación NCFAS
// Representa el "ciclo" completo de evaluación de una familia durante la intervención
Table NCFAS  {
	id_ncfas uuid [ pk, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	id_familiar uuid [ not null, note: 'Cuidador principal evaluado junto al NNA' ]
  "es_reunificacion" boolean [not null, default: false]

	fecha_apertura date [ note: 'Fecha en que se realiza la evaluación de Ingreso' ]
	fecha_cierre date [ note: 'Fecha en que se realiza la evaluación de Cierre' ]
	estado text [ note: 'Ej: Ingreso completado, Intermedio completado, Finalizado' ]
	observacion_general text
}

// 2. Catálogo de Ítems (Las preguntas del instrumento)
// Ej: Dimensión "A. Entorno", Ítem "1. Estabilidad de la vivienda"
Table ItemNCFAS  {
	id_item_ncfas uuid [ pk, default: `gen_random_uuid()` ]
	letra_dimension text [ not null, note: 'Ej: A, B, C, D...' ]
	nombre_dimension text [ not null, note: 'Ej: Entorno, Competencias Parentales...' ]
	numero_item integer [ not null, note: 'Ej: 1, 2, 3...' ]
	nombre_item text [ not null, note: 'Ej: Estabilidad de la Vivienda' ]
  "es_item_general" boolean [not null, default: false]

}

// 3. Respuestas/Puntuaciones
// Almacena el puntaje específico para un ítem, en un momento específico
Table RespuestaNCFAS  {
	id_respuesta_ncfas uuid [ pk, default: `gen_random_uuid()` ]
	id_ncfas uuid [ not null ]
	id_item_ncfas uuid [ not null ]
	momento_evaluacion text [ not null, note: 'Valores permitidos: Ingreso, Intermedio, Cierre' ]
	puntaje text [ not null, note: 'Valores: +2, +1, 0, -1, -2, -3, DN, N/A' ]

  // Garantiza que no se evalúe el mismo ítem dos veces en el mismo momento
  indexes {
    (id_ncfas, id_item_ncfas, momento_evaluacion) [unique]
  }


  Checks {
    `"momento_evaluacion" IN ('Ingreso', 'Intermedio', 'Cierre')` [name: 'chk_momento_evaluacion']
    `"puntaje" IN ('+2', '+1', '0', '-1', '-2', '-3', 'DN', 'N/A')` [name: 'chk_puntaje']
  }
}

// 4. Comentarios por Dimensión
// Almacena la caja de "Comentarios" que aparece al final de cada sección en el PDF
Table ComentarioDimensionNCFAS {
	id_comentario_ncfas uuid [ pk, default: `gen_random_uuid()` ]
	id_ncfas uuid [ not null ]
	letra_dimension text [ not null, note: 'Ej: A, B, C...' ]
	comentario text [ not null ]
  
  // Solo un bloque de comentarios por dimensión por caso
  indexes {
    (id_ncfas, letra_dimension) [unique]
  }
}

Table E2P  {
	id_e2p uuid [ pk, default: `gen_random_uuid()` ]
	id_nna uuid [ not null ]
	id_familiar uuid [ not null ]
	fecha_evaluacion date
	fecha_proxima_evaluacion date
	version integer [ not null ]
	resultado text
	observacion text
}

Table PreguntaE2P  {
	id_pregunta_e2p uuid [ pk, default: `gen_random_uuid()` ]
	version integer [ not null ]
	numero integer [ not null ]
	texto text [ not null ]
	categoria text [ not null ]
}

Table RespuestaE2P  {
	id_respuesta_e2p uuid [ pk, default: `gen_random_uuid()` ]
	id_e2p uuid [ not null ]
	id_pregunta_e2p uuid [ not null ]
	valor integer [ not null ]
}

Table BaremoE2P  {
	id_baremo_e2p uuid [ pk, default: `gen_random_uuid()` ]
	version integer [ not null ]
	categoria text [ not null ]
	zona text [ not null ]
	puntaje_min integer [ not null ]
	puntaje_max integer [ not null ]
}

Table PuntajeE2P  {
	id_puntaje_e2p uuid [ pk, default: `gen_random_uuid()` ]
	id_e2p uuid [ not null ]
	categoria text [ not null ]
	puntaje_bruto integer [ not null ]
	puntaje_max integer [ not null ]
	zona text [ not null ]
	rango_zona text [ not null ]
}

Table SolicitanteIngreso  {
	id_solicitante_ingreso uuid [ pk, default: `gen_random_uuid()` ]
	nombre text
	categoria text [ note: 'Ej: PRM, PRK, PRF, Hospital, etc.' ]
	ano_proyecto integer [ note: 'Año de adjudicación o vigencia del proyecto' ]
}

Table EstablecimientoEducacional  {
	id_establecimiento_educacional uuid [ pk, default: `gen_random_uuid()` ]
	nombre text
	rbd integer [ note: 'Rol Base de Datos del establecimiento' ]
}

Table CentroSalud  {
	id_centro_salud uuid [ pk, default: `gen_random_uuid()` ]
	nombre text
	tipo_recinto text [ note: 'Ej: CESFAM, Hospital, Clínica Privada, CECOSF' ]
}

Table RegistroGrupoFamiliar  {
	id_registro_grupo_familiar uuid [ pk, default: `gen_random_uuid()` ]
	id_familiar uuid [ not null ]
	id_antecedente_familiar uuid [ not null ]

  // Un familiar no puede estar duplicado en el mismo antecedente
  indexes {
    (id_familiar, id_antecedente_familiar) [unique]
  }
}

Table VinculoNNA  {
	id_vinculo_nna uuid [ pk, default: `gen_random_uuid()` ]
	id_nna_1 uuid [ not null ]
	id_nna_2 uuid [ not null ]
	parentesco text

  // Evitamos que se registre dos veces exactamente el mismo vínculo
  indexes {
    (id_nna_1, id_nna_2) [unique]
  }

  checks {
    `id_nna_1 < id_nna_2` [name: 'chk_vinculo_nna_orden']
  }
}

Table Usuario {
  id_usuario uuid [pk, not null]
  email text [not null, unique]
  hashed_password text [not null]
  nombre text 
  is_active bool
  created_at timestampz
  updated_at timestampz
}

