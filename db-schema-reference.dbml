Ref fk_RespuestaPMF_id_pmf_PMF {RespuestaPMF.id_pmf > PMF.id_pmf}

Ref fk_RespuestaPMF_id_pregunta_pmf_PreguntaPMF{RespuestaPMF.id_pregunta_pmf > PreguntaPMF.id_pregunta_pmf}

Ref fk_RespuestaNCFAS_id_ncfas_NCFAS {
	RespuestaNCFAS.id_ncfas > NCFAS.id_ncfas [ delete: cascade, update: no action ]
}

Ref fk_RespuestaNCFAS_id_item_ItemNCFAS {
