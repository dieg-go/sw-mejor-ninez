	HistorialConsumoAdulto.id_familiar > Familiar.id_familiar [ delete: no action, update: no action ]
}

Ref fk_DiscapacidadAdulto_id_familiar_Familiar {
	DiscapacidadAdulto.id_familiar > Familiar.id_familiar [ delete: no action, update: no action ]
}

Ref fk_E2P_id_nna_NNA {
